{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehtys-code-bridge",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm install && npm run build"
  }
}
